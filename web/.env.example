# ============================================================
# Web 客户端后端配置模板
# 复制为 web/.env 后填写；web/.env 不入库
# 生成随机密钥：python -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================

# JWT HS256 签名密钥（Spec 1 必填；缺失则启动报错，禁止使用默认密钥）
WEB_JWT_SECRET=

# 第三方 API Key 加密主密钥（Fernet）
# 真实模式（WEB_FAKE_MODE=0）必填，留空则启动快速失败；
# WEB_FAKE_MODE=1 时可留空：进程内生成临时密钥（重启后已加密凭据不可解，
# 假模式演示不依赖持久凭据），启动日志会打 warning。
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WEB_MASTER_KEY=

# 假模式：1=零密钥、零外部调用的离线演示（使用 web/fixtures/fake_run 内置物料）
WEB_FAKE_MODE=0

# 后台转写全局并发上限（每用户仍恒为 1 个活动任务）
WEB_MAX_CONCURRENT_TASKS=2

# 转写产物根目录（下含 <user_id>/<task_id>/）；留空则用仓库根 runs/
WEB_RUNS_DIR=

# PDF 上传大小上限（MB）
WEB_UPLOAD_MAX_MB=50

# 登录令牌有效期（分钟），默认 720 = 12 小时
WEB_TOKEN_EXPIRE_MINUTES=720

# SQLite 位置；留空则使用仓库根 data/app.db
WEB_DATABASE_URL=

# 开发态允许的前端来源（逗号分隔）；同域交付形态下不需要 CORS
WEB_CORS_ORIGINS=http://localhost:5173
