# 纸慧 PaperWise 生产环境配置
# 复制为 .env 后填写；.env 不入库
#
# 生成两个密钥（在服务器执行）：
#   docker run --rm python:3.12-slim python -c \
#   "import secrets; from cryptography.fernet import Fernet; \
#   print('WEB_JWT_SECRET=' + secrets.token_urlsafe(32)); \
#   print('WEB_MASTER_KEY=' + Fernet.generate_key().decode())"

# JWT 登录令牌签名密钥（必填）
WEB_JWT_SECRET=

# 第三方 API Key 加密主密钥（Fernet，真实模式必填）
WEB_MASTER_KEY=

# 真实模式
WEB_FAKE_MODE=0

# 后台并发转写上限
WEB_MAX_CONCURRENT_TASKS=2

# PDF 上传上限（MB）
WEB_UPLOAD_MAX_MB=50

# 登录令牌有效期（分钟），默认 12 小时
WEB_TOKEN_EXPIRE_MINUTES=720
